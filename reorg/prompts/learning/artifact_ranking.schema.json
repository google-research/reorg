{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group_ranking.schema.json",
  "title": "Unsupervised groupwise ranking result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group_id",
    "ranking_tiers",
    "hard_invalid",
    "decisive_difference"
  ],
  "properties": {
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "ranking_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/artifactLabel"
        }
      }
    },
    "hard_invalid": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactLabel"
      }
    },
    "decisive_difference": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "artifactLabel": {
      "type": "string",
      "pattern": "^artifact_[A-Z]+$"
    }
  }
}

